{
  "name": "@deepseek-ai/dsh-plugin-kestra-run",
  "description": "Kestra AIAgent execution-plane one-shot observer: env-driven model/tool selection, tool allowlist guard, and the structured /result.json contract the Kestra AIAgent task reads",
  "version": "0.1.2-alpha.3",
  "type": "module",
  "bin": {
    "dsh-run": "bin/dsh-run.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/dsh-run.mjs",
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "dsh.patch.yml"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "workspace:^",
    "@deepseek-ai/dsh-cmdline": "workspace:^",
    "@deepseek-ai/dsh-session": "workspace:^",
    "@deepseek-ai/dsh-tools": "workspace:^",
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.patch.yml"
    }
  }
}
