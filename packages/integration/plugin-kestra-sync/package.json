{
  "name": "@deepseek-ai/dsh-plugin-kestra-sync",
  "description": "Pushes dsh (PC) session state snapshots to Kestra — session sync client for the dsh.docx topology",
  "version": "0.1.7-rc.2",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./core": {
      "types": "./lib/types/core.d.ts",
      "default": "./lib/core.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-session": "workspace:^"
  },
  "dsh": {
    "bundle": {
      "patch": "./dsh.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-util-crypto": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/core.js",
    "lib/types/**/*.d.ts"
  ]
}
